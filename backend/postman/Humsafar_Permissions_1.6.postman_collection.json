{
  "info": {
    "name": "Humsafar API - Task 1.6 Permissions",
    "schema": "https://schema.getpostman.com/json/collections/v2.1.0/collection.json",
    "description": "Run top to bottom in the Collection Runner (Humsafar Local environment). Covers FR-A4: default deny, grant/revoke per module per Secondary, remote alarm never delegable."
  },
  "item": [
    {
      "name": "Setup",
      "item": [
        {
          "name": "1. Register primary guardian",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{pm_p_email}}\",\n  \"phone\": \"{{pm_p_phone}}\",\n  \"password\": \"{{test_password}}\",\n  \"role\": \"guardian\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = () => Math.floor(Math.random()*1e9).toString().padStart(9,'0');",
                  "const run = r();",
                  "pm.environment.set('pm_p_email','pmp'+run+'@humsafar-test.com'); pm.environment.set('pm_p_phone','03'+r());",
                  "pm.environment.set('pm_d_email','pmd'+run+'@humsafar-test.com'); pm.environment.set('pm_d_phone','03'+r());",
                  "pm.environment.set('pm_s_email','pms'+run+'@humsafar-test.com'); pm.environment.set('pm_s_phone','03'+r());",
                  "if (!pm.environment.get('test_password')) pm.environment.set('test_password','correct-horse-9');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Login primary",
          "request": {
            "method": "POST",
