            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('every module is false (default deny)', () => { const m = Object.values(pm.response.json().secondaries[0].modules); pm.expect(m.length).to.eql(6); pm.expect(m.every(v => v === false)).to.eql(true); });"
                ]
              }
            }
          ]
        },
        {
          "name": "11. Secondary: my permissions (all false)",
          "request": {
            "method": "GET",
            "header": [
