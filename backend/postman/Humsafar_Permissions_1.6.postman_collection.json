              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('secondary, nothing granted', () => { const b = pm.response.json(); pm.expect(b.guardian_role).to.eql('secondary'); pm.expect(Object.values(b.modules).every(v => v === false)).to.eql(true); });"
                ]
