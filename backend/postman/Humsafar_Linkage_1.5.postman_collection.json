            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{lk_p_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/dependents/{{lk_d_id}}/guardians",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "dependents",
                "{{lk_d_id}}",
                "guardians"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('primary first, then two secondaries', () => pm.expect(pm.response.json().map(g => g.guardian_role)).to.eql(['primary','secondary','secondary']));"
                ]
              }
            }
          ]
        }
      ]
