              },
              {
                "key": "Authorization",
                "value": "Bearer {{lk_p_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/guardians/me/verify-cnic",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "guardians",
                "me",
                "verify-cnic"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cnic\": \"42101-1234567-1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
