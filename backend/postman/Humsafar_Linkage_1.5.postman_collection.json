            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.environment.set('lk_p_token', pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Link before verification (expect 403)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{lk_p_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/dependents/{{lk_d_id}}/link",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "dependents",
                "{{lk_d_id}}",
                "link"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403', () => pm.response.to.have.status(403));",
                  "pm.test('GUARDIAN_NOT_VERIFIED', () => pm.expect(pm.response.json().error.code).to.eql('GUARDIAN_NOT_VERIFIED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Verify primary (CNIC)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
