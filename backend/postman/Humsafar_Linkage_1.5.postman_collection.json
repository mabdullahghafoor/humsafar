{
  "info": {
    "name": "Humsafar API - Task 1.5 Linkage",
    "schema": "https://schema.getpostman.com/json/collections/v2.1.0/collection.json",
    "description": "Run top to bottom in the Collection Runner (needs Humsafar Local environment). Covers FR-B1, FR-B2, FR-B4 and the Dependent activation rule."
  },
  "item": [
    {
      "name": "Setup",
      "item": [
        {
          "name": "1. Register primary guardian",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{lk_p_email}}\",\n  \"phone\": \"{{lk_p_phone}}\",\n  \"password\": \"{{test_password}}\",\n  \"role\": \"guardian\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = () => Math.floor(Math.random()*1e9).toString().padStart(9,'0');",
                  "const run = r();",
                  "pm.environment.set('lk_p_email', 'lkp' + run + '@humsafar-test.com'); pm.environment.set('lk_p_phone', '03' + r());",
                  "pm.environment.set('lk_o_email', 'lko' + run + '@humsafar-test.com'); pm.environment.set('lk_o_phone', '03' + r());",
                  "pm.environment.set('lk_d_email', 'lkd' + run + '@humsafar-test.com'); pm.environment.set('lk_d_phone', '03' + r());",
                  "pm.environment.set('lk_s1_email', 'lks1' + run + '@humsafar-test.com'); pm.environment.set('lk_s1_phone', '03' + r());",
                  "pm.environment.set('lk_s2_email', 'lks2' + run + '@humsafar-test.com'); pm.environment.set('lk_s2_phone', '03' + r());",
                  "pm.environment.set('lk_s3_phone', '03' + r());",
                  "const d = Math.floor(Math.random()*1e11).toString().padStart(11,'0');",
                  "pm.environment.set('lk_d_cnic', '4' + d + '1');",
                  "if (!pm.environment.get('test_password')) pm.environment.set('test_password', 'correct-horse-9');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "pm.test('primary', () => pm.expect(pm.response.json().guardian_role).to.eql('primary'));"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Login primary",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{lk_p_email}}\",\n  \"password\": \"{{test_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
