{
  "info": {
    "name": "Humsafar API - Task 1.4 KYC",
    "schema": "https://schema.getpostman.com/json/collections/v2.1.0/collection.json",
    "description": "Run top to bottom (Collection Runner). Mock rules: CNIC ending 0 = failed, ending 9 = pending then verified on resubmit, liveness text starting FAIL = failed, OTP = 123456."
  },
  "item": [
    {
      "name": "Guardian verification (FR-A3)",
      "item": [
        {
          "name": "1. Register guardian",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{kyc_guardian_email}}\",\n  \"phone\": \"{{kyc_guardian_phone}}\",\n  \"password\": \"{{test_password}}\",\n  \"role\": \"guardian\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const n = Math.floor(Math.random()*1e9).toString().padStart(9,'0');",
                  "pm.environment.set('kyc_guardian_email', 'kycg' + n + '@humsafar-test.com');",
                  "pm.environment.set('kyc_guardian_phone', '03' + n);",
                  "if (!pm.environment.get('test_password')) pm.environment.set('test_password', 'correct-horse-9');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Login guardian",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{kyc_guardian_email}}\",\n  \"password\": \"{{test_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.environment.set('access_token', pm.response.json().access_token);",
                  "pm.environment.set('refresh_token', pm.response.json().refresh_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Verification status (expect not verified)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/guardians/me/verification",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "guardians",
                "me",
                "verification"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('not verified yet', () => pm.expect(pm.response.json().verified).to.eql(false));"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Request phone OTP",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/guardians/me/verify-phone/request",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "guardians",
                "me",
                "verify-phone",
                "request"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.environment.set('otp_code', pm.response.json().dev_otp);",
                  "pm.test('OTP sent', () => pm.expect(pm.response.json().sent).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "5. Confirm wrong OTP (expect 400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/guardians/me/verify-phone/confirm",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "guardians",
                "me",
                "verify-phone",
                "confirm"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"000000\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400', () => pm.response.to.have.status(400));",
                  "pm.test('OTP_INVALID', () => pm.expect(pm.response.json().error.code).to.eql('OTP_INVALID'));"
                ]
              }
            }
          ]
        },
        {
          "name": "6. Confirm correct OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/guardians/me/verify-phone/confirm",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "guardians",
                "me",
                "verify-phone",
                "confirm"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{otp_code}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('verified', () => pm.expect(pm.response.json().verified).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "7. Verify guardian CNIC",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/guardians/me/verify-cnic",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "guardians",
                "me",
                "verify-cnic"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cnic\": \"42101-1234567-1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('cnic verified', () => pm.expect(pm.response.json().cnic_verified).to.eql(true));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Dependent KYC (FR-A2)",
      "item": [
        {
          "name": "8. Register dependent",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{kyc_dep_email}}\",\n  \"phone\": \"{{kyc_dep_phone}}\",\n  \"password\": \"{{test_password}}\",\n  \"role\": \"dependent\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const n = Math.floor(Math.random()*1e9).toString().padStart(9,'0');",
                  "pm.environment.set('kyc_dep_email', 'kycd' + n + '@humsafar-test.com');",
                  "pm.environment.set('kyc_dep_phone', '03' + n);",
                  "// unique CNIC per run, ending in 1 so the mock verifies it",
                  "const d = Math.floor(Math.random()*1e11).toString().padStart(11,'0');",
                  "pm.environment.set('kyc_dep_cnic', '4' + d + '1');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "pm.environment.set('dependent_id', pm.response.json().user_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "9. Dependent cannot log in yet (expect 403)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{kyc_dep_email}}\",\n  \"password\": \"{{test_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403', () => pm.response.to.have.status(403));",
                  "pm.test('ACCOUNT_NOT_ACTIVATED', () => pm.expect(pm.response.json().error.code).to.eql('ACCOUNT_NOT_ACTIVATED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "10. KYC with failing liveness photo (expect failed)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/dependents/{{dependent_id}}/kyc-verify",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "dependents",
                "{{dependent_id}}",
                "kyc-verify"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"{{test_password}}\",\n  \"cnic\": \"{{kyc_dep_cnic}}\",\n  \"liveness_image\": \"FAIL-blurry-photo\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('failed', () => pm.expect(pm.response.json().status).to.eql('failed'));",
                  "pm.test('retry', () => pm.expect(pm.response.json().next_step).to.eql('retry'));"
                ]
              }
            }
          ]
        },
        {
          "name": "11. KYC wrong password (expect 401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/dependents/{{dependent_id}}/kyc-verify",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "dependents",
                "{{dependent_id}}",
                "kyc-verify"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"definitely-wrong-1\",\n  \"cnic\": \"{{kyc_dep_cnic}}\",\n  \"liveness_image\": \"VGhpcyBpcyBhIHBob3Rv\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401', () => pm.response.to.have.status(401));",
                  "pm.test('INVALID_CREDENTIALS', () => pm.expect(pm.response.json().error.code).to.eql('INVALID_CREDENTIALS'));"
                ]
              }
            }
          ]
        },
        {
          "name": "12. KYC verified",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/dependents/{{dependent_id}}/kyc-verify",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "dependents",
                "{{dependent_id}}",
                "kyc-verify"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"{{test_password}}\",\n  \"cnic\": \"{{kyc_dep_cnic}}\",\n  \"liveness_image\": \"VGhpcyBpcyBhIHBob3Rv\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('verified', () => pm.expect(pm.response.json().status).to.eql('verified'));",
                  "pm.test('waiting for a Primary Guardian', () => pm.expect(pm.response.json().next_step).to.eql('link_primary_guardian'));"
                ]
              }
            }
          ]
        },
        {
          "name": "13. KYC again (expect 409 already verified)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/dependents/{{dependent_id}}/kyc-verify",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "dependents",
                "{{dependent_id}}",
                "kyc-verify"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"{{test_password}}\",\n  \"cnic\": \"{{kyc_dep_cnic}}\",\n  \"liveness_image\": \"VGhpcyBpcyBhIHBob3Rv\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409', () => pm.response.to.have.status(409));",
                  "pm.test('ALREADY_VERIFIED', () => pm.expect(pm.response.json().error.code).to.eql('ALREADY_VERIFIED'));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}