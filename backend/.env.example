# Copy this file to .env and fill in your local values. Never commit .env itself.

APP_NAME=Humsafar API
ENVIRONMENT=development
DEBUG=True

# Replace YOUR_PASSWORD with the postgres superuser password you set during install
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/humsafar_dev

# Task 1.3 — REQUIRED: generate a real secret and paste it below. Run:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-in-.env
JWT_ALGORITHM=HS256
# SDS 11.3: short-lived access tokens (~15 minutes)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Task 1.4 — KYC. Only the mock provider exists until a real vendor is chosen.
KYC_PROVIDER=mock
# The fixed OTP the mock accepts for guardian phone verification (development only).
MOCK_OTP_CODE=123456

# Task 3.1 — push notifications. Only 'mock' exists until Talha's Firebase project is ready (Task 3.14).
PUSH_PROVIDER=mock

# Task 4.4 — voice / video calls. Only 'mock' exists until the ZegoCloud keys are available (then add ZEGO_APP_ID and ZEGO_SERVER_SECRET here, never in the app).
CALL_PROVIDER=mock
