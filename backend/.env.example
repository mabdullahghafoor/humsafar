# Copy this file to .env and fill in your local values. Never commit .env itself.

APP_NAME=Humsafar API
ENVIRONMENT=development
DEBUG=True

# Task 0.3 — replace YOUR_PASSWORD with the postgres superuser password you set during install
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/humsafar_dev

# Task 1.3 — generate a real secret before Auth work begins, e.g.: openssl rand -hex 32
JWT_SECRET_KEY=change-me-in-.env
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
