        ]
       }
      }
     ],
     "response": []
    },
    {
     "name": "12. Dependent's camera phone pairs itself",
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       },
       {
        "key": "Authorization",
        "value": "Bearer {{cm_d_token}}"
       }
      ],
      "url": {
       "raw": "{{base_url}}/dependents/{{cm_d_id}}/camera",
       "host": [
        "{{base_url}}"
       ],
       "path": [
        "dependents",
        "{{cm_d_id}}",
        "camera"
       ]
      },
      "description": "FR-K1. The camera is a spare Android phone signed in as the Dependent, in camera mode. Pairing gives it a private video room. The Dependent or the Primary can pair; pairing again only changes the name (200). `name` is optional, max 60.",
      "body": {
       "mode": "raw",
       "raw": "{\n  \"name\": \"Hall phone\"\n}",
       "options": {
        "raw": {
         "language": "json"
        }
       }
      }
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('201', () => pm.response.to.have.status(201));",
         "const j = pm.response.json();",
         "pm.test('paired, not online yet', () => { pm.expect(j.paired).to.eql(true); pm.expect(j.name).to.eql('Hall phone'); pm.expect(j.online).to.eql(false); pm.expect(j.max_viewers).to.eql(3); });"
        ]
       }
      }
     ],
     "response": [
      {
       "name": "201 Created",
       "originalRequest": {
        "method": "POST",
        "header": [
         {
          "key": "Content-Type",
          "value": "application/json"
         },
         {
          "key": "Authorization",
          "value": "Bearer {{cm_d_token}}"
         }
        ],
        "url": {
         "raw": "{{base_url}}/dependents/{{cm_d_id}}/camera",
         "host": [
          "{{base_url}}"
         ],
         "path": [
          "dependents",
          "{{cm_d_id}}",
          "camera"
         ]
        },
        "description": "FR-K1. The camera is a spare Android phone signed in as the Dependent, in camera mode. Pairing gives it a private video room. The Dependent or the Primary can pair; pairing again only changes the name (200). `name` is optional, max 60.",
        "body": {
         "mode": "raw",
         "raw": "{\n  \"name\": \"Hall phone\"\n}",
         "options": {
          "raw": {
           "language": "json"
          }
         }
        }
       },
       "status": "Created",
       "code": 201,
       "_postman_previewlanguage": "json",
       "header": [
        {
         "key": "Content-Type",
         "value": "application/json"
        }
       ],
       "body": "{\n  \"paired\": true,\n  \"camera_id\": \"5d6e7f80-9a0b-4c1d-8e2f-3a4b5c6d7e8f\",\n  \"name\": \"Hall phone\",\n  \"paired_at\": \"2026-10-21T10:00:00Z\",\n  \"online\": true,\n  \"last_seen_at\": \"2026-10-21T10:00:05Z\",\n  \"viewers_now\": 1,\n  \"max_viewers\": 3\n}"
      }
     ]
    },
    {
     "name": "15. Camera phone checks in (nobody watching)",
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Authorization",
        "value": "Bearer {{cm_d_token}}"
       }
      ],
      "url": {
       "raw": "{{base_url}}/dependents/{{cm_d_id}}/camera/heartbeat",
       "host": [
        "{{base_url}}"
       ],
       "path": [
        "dependents",
        "{{cm_d_id}}",
        "camera",
        "heartbeat"
       ]
      },
      "description": "Only the Dependent's own phone. Call every `next_poll_s` seconds. The phone sends video only when `should_publish` is true (privacy and battery)."
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('200', () => pm.response.to.have.status(200));",
         "pm.test('stay dark', () => { const j = pm.response.json(); pm.expect(j.should_publish).to.eql(false); pm.expect(j.next_poll_s).to.eql(10); });"
        ]
       }
      }
     ],
     "response": []
    },
    {
     "name": "17. Primary starts watching \u2014 check the token is not cached (S-12)",
     "request": {
      "method": "GET",
      "header": [
       {
        "key": "Authorization",
        "value": "Bearer {{cm_p_token}}"
       }
      ],
      "url": {
       "raw": "{{base_url}}/dependents/{{cm_d_id}}/camera/stream",
       "host": [
        "{{base_url}}"
       ],
       "path": [
        "dependents",
        "{{cm_d_id}}",
        "camera",
        "stream"
       ]
      },
      "description": "Starts a viewing session (90 seconds) and returns the room join token (a viewer token cannot send video). Call it again before `expires_at` (every `renew_every_s`) to keep watching; the app stops calling when the screen closes. At most 3 viewers at once (409 `TOO_MANY_VIEWERS`)."
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('200', () => pm.response.to.have.status(200));",
         "const j = pm.response.json();",
         "pm.test('session and viewer token', () => { pm.expect(j.renewed).to.eql(false); pm.expect(j.join.token).to.be.a('string').and.not.empty; pm.expect(j.join.room_id).to.include('cam-'); pm.expect(j.renew_every_s).to.eql(30); });",
         "pm.environment.set('cm_session', j.session_id);",
         "pm.test('S-12: Cache-Control has no-store', () => pm.expect((pm.response.headers.get('Cache-Control')||'').toLowerCase()).to.include('no-store'));",
         "pm.test('S-12: Cache-Control is private', () => pm.expect((pm.response.headers.get('Cache-Control')||'').toLowerCase()).to.include('private'));"
        ]
       }
      }
     ],
     "response": [
      {
       "name": "200 OK",
       "originalRequest": {
        "method": "GET",
        "header": [
         {
          "key": "Authorization",
          "value": "Bearer {{cm_p_token}}"
         }
        ],
        "url": {
         "raw": "{{base_url}}/dependents/{{cm_d_id}}/camera/stream",
         "host": [
          "{{base_url}}"
         ],
         "path": [
          "dependents",
          "{{cm_d_id}}",
          "camera",
          "stream"
         ]
        },
        "description": "Starts a viewing session (90 seconds) and returns the room join token (a viewer token cannot send video). Call it again before `expires_at` (every `renew_every_s`) to keep watching; the app stops calling when the screen closes. At most 3 viewers at once (409 `TOO_MANY_VIEWERS`)."
       },
       "status": "OK",
       "code": 200,
       "_postman_previewlanguage": "json",
       "header": [
        {
         "key": "Content-Type",
         "value": "application/json"
        }
       ],
       "body": "{\n  \"session_id\": \"6e7f8091-a0b1-4c2d-9e3f-4a5b6c7d8e9f\",\n  \"dependent_id\": \"00000000-0000-0000-0000-000000000002\",\n  \"camera_name\": \"Hall phone\",\n  \"started_at\": \"2026-10-21T10:00:00Z\",\n  \"expires_at\": \"2026-10-21T10:01:30Z\",\n  \"renew_every_s\": 30,\n  \"join\": {\n    \"provider\": \"zego\",\n    \"app_id\": \"123456789\",\n    \"room_id\": \"cam-00000000000000000000000000000002\",\n    \"stream_id\": \"cam-00000000000000000000000000000002-stream\",\n    \"user_id\": \"00000000-0000-0000-0000-000000000001\",\n    \"token\": \"<token for this viewer>\",\n    \"expires_at\": \"2026-10-21T10:01:30Z\"\n  },\n  \"renewed\": false\n}"
      }
     ]
    },
    {
     "name": "30. Primary stops watching",
     "request": {
      "method": "DELETE",
      "header": [
       {
        "key": "Authorization",
        "value": "Bearer {{cm_p_token}}"
       }
      ],
      "url": {
       "raw": "{{base_url}}/dependents/{{cm_d_id}}/camera/stream",
       "host": [
        "{{base_url}}"
       ],
       "path": [
        "dependents",
        "{{cm_d_id}}",
        "camera",
        "stream"
       ]
      },
      "description": "Safe to repeat. Leaving never needs permission."
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('204', () => pm.response.to.have.status(204));"
        ]
       }
      }
     ],
     "response": []
    }
   ]
  },
