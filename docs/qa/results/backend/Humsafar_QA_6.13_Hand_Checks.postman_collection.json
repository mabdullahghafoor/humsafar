     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('201', () => pm.response.to.have.status(201));"
        ]
       }
      }
     ],
     "response": []
    },
    {
     "name": "7. Login dependent (the phone's token)",
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "url": {
       "raw": "{{base_url}}/auth/login",
       "host": [
        "{{base_url}}"
       ],
       "path": [
        "auth",
        "login"
       ]
      },
      "description": "The Dependent's phone gets its token.",
      "body": {
       "mode": "raw",
       "raw": "{\n  \"email\": \"{{cm_d_email}}\",\n  \"password\": \"{{test_password}}\"\n}",
       "options": {
        "raw": {
         "language": "json"
        }
       }
      }
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
