{
 "info": {
  "name": "Humsafar 6.13 hand checks (S-09, S-12)",
  "schema": "https://schema.getpostman.com/json/collections/v2.1.0/collection.json",
  "description": "Two security checks from the 6.13 review that are not in the main collection. Run with the Humsafar - Local environment on a freshly started backend."
 },
 "item": [
  {
   "name": "S-12 Camera stream token is not cached",
   "item": [
    {
     "name": "1. Register primary guardian",
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "url": {
       "raw": "{{base_url}}/auth/register",
       "host": [
        "{{base_url}}"
       ],
       "path": [
        "auth",
        "register"
       ]
      },
      "description": "Create the Guardian who will be Primary.",
      "body": {
       "mode": "raw",
       "raw": "{\n  \"email\": \"{{cm_p_email}}\",\n  \"phone\": \"{{cm_p_phone}}\",\n  \"password\": \"{{test_password}}\",\n  \"full_name\": \"Test User\",\n  \"role\": \"guardian\"\n}",
       "options": {
        "raw": {
         "language": "json"
        }
       }
      }
     },
     "event": [
      {
       "listen": "prerequest",
       "script": {
        "type": "text/javascript",
        "exec": [
         "const r = () => Math.floor(Math.random()*1e9).toString().padStart(9,'0');",
         "const run = r();",
         "pm.environment.set('cm_p_email','cmp'+run+'@humsafar-test.com'); pm.environment.set('cm_p_phone','03'+r());",
         "pm.environment.set('cm_d_email','cmd'+run+'@humsafar-test.com'); pm.environment.set('cm_d_phone','03'+r());",
         "pm.environment.set('cm_s_email','cms'+run+'@humsafar-test.com'); pm.environment.set('cm_s_phone','03'+r());",
         "const d = Math.floor(Math.random()*1e11).toString().padStart(11,'0'); pm.environment.set('cm_d_cnic','4'+d+'1');",
         "if (!pm.environment.get('test_password')) pm.environment.set('test_password','correct-horse-9');"
        ]
       }
      },
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('201', () => pm.response.to.have.status(201));"
        ]
       }
      }
     ],
     "response": []
    },
    {
     "name": "2. Login primary",
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "url": {
       "raw": "{{base_url}}/auth/login",
       "host": [
        "{{base_url}}"
       ],
       "path": [
        "auth",
        "login"
       ]
      },
      "description": "Log in the Primary.",
      "body": {
       "mode": "raw",
       "raw": "{\n  \"email\": \"{{cm_p_email}}\",\n  \"password\": \"{{test_password}}\"\n}",
       "options": {
        "raw": {
         "language": "json"
        }
       }
      }
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('200', () => pm.response.to.have.status(200));",
         "pm.environment.set('cm_p_token', pm.response.json().access_token);"
        ]
       }
      }
     ],
     "response": []
    },
