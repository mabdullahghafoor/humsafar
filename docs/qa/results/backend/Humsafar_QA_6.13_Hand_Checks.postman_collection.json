      "body": {
       "mode": "raw",
       "raw": "{\n  \"password\": \"{{test_password}}\",\n  \"cnic\": \"{{cm_d_cnic}}\",\n  \"liveness_image\": \"VGhpcyBpcyBhIHBob3Rv\"\n}",
